# Embodied Marketing 环境变量配置
# 复制此文件为 .env.local 并填入实际值
# cp .env.example .env.local

# ==========================================
# 飞书开放平台配置（必需）
# ==========================================
# 获取地址: https://open.feishu.cn/app
FEISHU_APPID=your_feishu_app_id_here
FEISHU_APP_SECRET=your_feishu_app_secret_here

# ==========================================
# 应用基础URL（生产环境必需）
# ==========================================
# 格式: http://your-domain.com 或 http://ip:port
NEXT_PUBLIC_BASE_URL=http://101.200.222.139:8082

# ==========================================
# Node.js 环境
# ==========================================
NODE_ENV=production

# ==========================================
# 数据库配置（可选，使用默认值）
# ==========================================
# DATABASE_PATH=./bilibili_monitor.db